{
  "name": "meshat-rest-api",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "start": "bun src/server.ts",
    "test": "bun test",
    "test:live": "bun tests/live-endpoints.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test",
    "test:integration": "bun scripts/test-integration.mjs",
    "check:full": "bun run check && bun run test:integration"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/swagger": "9.5.2",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "5.12.1",
    "zod": "4.2.0",
    "@fastify/type-provider-zod": "1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "1.4.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0"
  }
}
